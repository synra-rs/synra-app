{
  "name": "synra-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Synra application: the Tauri shell and the host interface",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "check": "vue-tsc -b && pnpm run shapes",
    "shapes": "tsx scripts/check-shapes.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@synra/client": "workspace:*",
    "@synra/protocol": "workspace:*",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.8.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}