{
  "name": "synra-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The Synra application: the Tauri shell and the host interface",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:facade && vue-tsc -b && vite build",
    "build:facade": "vite build --config vite.inject.config.ts",
    "build:android": "tauri android build",
    "build:ios": "tauri ios build",
    "check": "vue-tsc -b && pnpm run shapes",
    "shapes": "esno scripts/check-shapes.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@synra/client": "workspace:*",
    "@synra/protocol": "workspace:*",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "ant-design-vue": "4.2.6",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/carbon": "^1.2.30",
    "@synra/testkit": "workspace:*",
    "@synra/theme": "workspace:*",
    "@tauri-apps/api": "^2.13.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.11",
    "@unocss/eslint-plugin": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.16.0",
    "esno": "^4.8.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "typescript": "6.0.3",
    "unocss": "^66.13.0",
    "unplugin-build-stamp": "^0.2.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
