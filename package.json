{
  "name": "synra-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The Synra application: the Tauri shell and the host interface",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:facade && vue-tsc -b && vite build",
    "build:facade": "vite build --config vite.inject.config.ts",
    "check": "vue-tsc -b && pnpm run shapes",
    "shapes": "esno scripts/check-shapes.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@synra/client": "workspace:*",
    "@synra/protocol": "workspace:*",
    "ant-design-vue": "4.2.6",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/carbon": "^1.2.28",
    "@synra/theme": "workspace:*",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@unocss/eslint-plugin": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "esno": "^4.8.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
