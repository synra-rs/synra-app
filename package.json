{
  "name": "synra-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Synra application: the Tauri shell and the host interface",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "check": "vue-tsc -b && pnpm run shapes",
    "shapes": "esno scripts/check-shapes.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@synra/client": "workspace:*",
    "@synra/protocol": "workspace:*",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "esno": "^4.8.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
