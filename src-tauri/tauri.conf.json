{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synra",
  "version": "0.1.0",
  "identifier": "com.synra.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synra",
        "width": 1100,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["synra"],
        "mimeType": "application/x-synra",
        "name": "Synra plugin package",
        "description": "A signed plugin package that Synra installs when it is opened."
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["synra"]
      }
    }
  }
}
